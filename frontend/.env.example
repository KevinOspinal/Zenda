# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.
# Aquí solo va configuración pública: todo lo que empieza con NUXT_PUBLIC_ termina dentro
# de la app que descarga el navegador. Nunca pongas secretos.

# Dirección del API (backend). En desarrollo, el backend corre en el puerto 3000.
NUXT_PUBLIC_API_URL=http://localhost:3000

# Muestra el enlace "Registrar mi negocio" en el ingreso. En producción: false.
NUXT_PUBLIC_REGISTRO_HABILITADO=true
