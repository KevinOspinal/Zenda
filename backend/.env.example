# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Coinciden con docker-compose.yml (solo desarrollo).
# Puertos del host; PostgreSQL usa 5433 para no chocar con una instalación local.
POSTGRES_PORT=5433
REDIS_PORT=6379
DATABASE_URL=postgresql://zenda:zenda@localhost:5433/zenda
REDIS_URL=redis://localhost:6379
