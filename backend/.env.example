# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Coinciden con docker-compose.yml (solo desarrollo).
# Puertos del host; PostgreSQL usa 5433 para no chocar con una instalación local.
POSTGRES_PORT=5433
REDIS_PORT=6379

# La app se conecta con un usuario sin privilegios para que Row-Level Security siempre aplique.
DATABASE_URL=postgresql://zenda_app:zenda_app@localhost:5433/zenda
# Las migraciones usan el usuario dueño de las tablas. Solo lo usa la CLI de Prisma.
DATABASE_URL_MIGRACIONES=postgresql://zenda:zenda@localhost:5433/zenda

REDIS_URL=redis://localhost:6379

# Clave para firmar los tokens de acceso. Genera una propia con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_MINUTOS=15
REFRESH_TOKEN_DIAS=30

# Contraseña de los usuarios de ejemplo que crea npm run db:seed (mínimo 8 caracteres).
SEED_CONTRASENA=

# Dominios desde los que un navegador puede usar el API y Socket.IO, separados por coma.
CORS_ORIGENES=http://localhost:3001

# Documentación Swagger en /docs. Por defecto activa en desarrollo y apagada en producción.
# DOCS_HABILITADA=true
