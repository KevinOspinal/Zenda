              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos",
              "host": ["{{baseUrl}}"],
              "path": ["pedidos"]
            },
            "description": "El mesero toma el pedido: 2 hamburguesas IND Classic Artesanal y 1 gaseosa personal. La mesa queda ocupada.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenMesero}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mesaId\": \"{{mesaId}}\",\n  \"items\": [\n    {\n      \"productoId\": \"{{idHamburguesa}}\",\n      \"cantidad\": 2,\n      \"notas\": \"Sin cebolla\"\n    },\n    {\n      \"productoId\": \"{{idGaseosa}}\",\n      \"cantidad\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.collectionVariables.set('pedidoId', p.id);",
                  "pm.collectionVariables.set('itemId', p.items[0].id);",
                  "pm.test('Total $28.000 (2 × 12.000 + 4.000)', () => pm.expect(p.total).to.eql('28000'));",
                  "pm.test('Subtotal e INC según la DIAN', () => {",
                  "  pm.expect(p.subtotal).to.eql('25925.92');",
                  "  pm.expect(p.impuestos).to.eql('2074.08');",
                  "});"
                ]
              }
            }
          ]
        },
