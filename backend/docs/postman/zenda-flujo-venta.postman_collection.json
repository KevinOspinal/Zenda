{
  "info": {
    "name": "Zenda - Flujo de venta (La Industria)",
    "description": "Simulación completa de una venta: login, abrir caja, pedido en mesa, cocina, cobro, anulación, cierre de caja y auditoría.\n\nAntes de empezar: docker compose up -d, npm run db:seed y npm run dev. Llena la variable 'password' con el valor de SEED_CONTRASENA de tu .env. Ejecuta las carpetas en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Preparación",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Comprueba que el API está corriendo (npm run dev).",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Responde 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Login Cajero",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Inicia sesión como cajero y guarda su token en la variable tokenCajero.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nit\": \"{{nit}}\",\n  \"email\": \"cajero@laindustria.test\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('tokenCajero', r.tokenAcceso);",
                  "pm.collectionVariables.set('refreshCajero', r.refreshToken);",
                  "pm.test('Rol cajero', () => pm.expect(r.usuario.rol).to.eql('cajero'));"
                ]
              }
            }
          ]
