                  "const buscar = (nombre) => productos.find((p) => p.nombre === nombre).id;",
                  "pm.collectionVariables.set('idHamburguesa', buscar('IND Classic Artesanal'));",
                  "pm.collectionVariables.set('idGaseosa', buscar('Gaseosa personal 400 ml'));",
